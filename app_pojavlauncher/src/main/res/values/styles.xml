<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Default dark blue theme -->
    <style name="AppTheme" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#0A1220</item>
        <item name="android:navigationBarColor">#0A1220</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="colorBgApp">#0D1521</item>
        <item name="colorBgBottomBar">#0A1220</item>
        <item name="colorBgStatusBar">#0A1220</item>
        <item name="colorDivider">#1E3A5F</item>
        <item name="themeAccent">@color/minebutton_color</item>
        <item name="colorTextPrimary">@color/primary_text</item>
        <item name="colorTextSecondary">@color/secondary_text</item>
        <item name="bgMainDrawable">#0D1521</item>
        <item name="android:windowBackground">#0D1521</item>
        <item name="colorAccent">#1E90FF</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="colorOnSurfaceVariant">@color/secondary_text</item>
        <item name="colorSurface">#121C2D</item>
        <item name="colorSurfaceVariant">#1E2A3A</item>
    </style>

    <style name="AppTheme.Gradient">
        <item name="bgMainDrawable">@drawable/bg_gradient_midnight_blue</item>
        <item name="android:windowBackground">@drawable/bg_gradient_midnight_blue</item>
        <item name="colorBgBottomBar">@color/mb_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/mb_bg_status_bar</item>
        <item name="colorAccent">#1E90FF</item>
    </style>

    <!-- Preset themes -->
    <style name="AppTheme.MidnightBlue">
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="colorBgApp">#121212</item>
        <item name="colorBgBottomBar">#121212</item>
        <item name="colorBgStatusBar">#121212</item>
        <item name="colorDivider">#464646</item>
        <item name="themeAccent">@color/mb_accent</item>
        <item name="colorTextPrimary">@color/mb_text_primary</item>
        <item name="colorTextSecondary">@color/mb_text_secondary</item>
        <item name="bgMainDrawable">#121212</item>
        <item name="android:windowBackground">#121212</item>
        <item name="colorAccent">#1E90FF</item>
        <item name="colorOnSurface">@color/mb_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/mb_text_secondary</item>
        <item name="colorSurface">#121212</item>
        <item name="colorSurfaceVariant">#1E1E1E</item>
    </style>
    <style name="AppTheme.MidnightBlue.Gradient">
        <item name="android:statusBarColor">@color/mb_bg_status_bar</item>
        <item name="android:navigationBarColor">@color/mb_bg_app</item>
        <item name="bgMainDrawable">@drawable/bg_gradient_midnight_blue</item>
        <item name="android:windowBackground">@drawable/bg_gradient_midnight_blue</item>
        <item name="colorBgBottomBar">@color/mb_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/mb_bg_status_bar</item>
        <item name="colorAccent">#1E90FF</item>
    </style>

    <!-- Other existing preset styles inherit the blue-safe base colors where applicable. -->
    <style name="AppTheme.ForestGreen" parent="AppTheme.MidnightBlue" />
    <style name="AppTheme.ForestGreen.Gradient" parent="AppTheme.MidnightBlue.Gradient" />
    <style name="AppTheme.Crimson" parent="AppTheme.MidnightBlue" />
    <style name="AppTheme.Crimson.Gradient" parent="AppTheme.MidnightBlue.Gradient" />
    <style name="AppTheme.Amethyst" parent="AppTheme.MidnightBlue" />
    <style name="AppTheme.Amethyst.Gradient" parent="AppTheme.MidnightBlue.Gradient" />
    <style name="AppTheme.Arctic" parent="AppTheme.MidnightBlue" />
    <style name="AppTheme.Arctic.Gradient" parent="AppTheme.MidnightBlue.Gradient" />

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">?attr/colorDivider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>
    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>
    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="SettingsFullScreenTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/SettingsActivityAnim</item>
    </style>
    <style name="SettingsActivityAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

</resources>
